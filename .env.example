# ============================================================
#  JARVIS - configuration
#  Copie ce fichier en `.env` et remplis au minimum la cle API.
# ============================================================

# --- OBLIGATOIRE : cle API Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Identite ---
JARVIS_NAME=Jarvis
USER_NAME=Allan

# --- Modele ---
# claude-opus-5 = le plus capable. claude-sonnet-5 = moins cher, plus rapide.
JARVIS_MODEL=claude-opus-5
# Profondeur de raisonnement : low | medium | high | xhigh | max
# "medium" garde les reponses vives a l'oral ; "high" pour les taches complexes.
JARVIS_EFFORT=medium
JARVIS_MAX_TOKENS=8000
JARVIS_MAX_TOOL_TURNS=25

# --- Voix ---
JARVIS_VOICE=true
JARVIS_WAKE_WORD=jarvis
# Voix francaises : fr-FR-HenriNeural (h), fr-FR-DeniseNeural (f),
# fr-FR-EloiseNeural (f, jeune), fr-CA-AntoineNeural (h, quebecois)
JARVIS_TTS_VOICE=fr-FR-HenriNeural
JARVIS_TTS_RATE=+8%
# Modele de transcription : tiny | base | small | medium
JARVIS_WHISPER_MODEL=small
JARVIS_LANG=fr
# Silence (s) qui marque la fin d une phrase
JARVIS_SILENCE=0.9
# Sensibilite du micro : augmente si la piece est bruyante (0.01 - 0.05)
JARVIS_MIC_THRESHOLD=0.015
# Duree (s) pendant laquelle on peut enchainer sans redire "Jarvis"
JARVIS_FOLLOWUP_WINDOW=12

# --- Securite ---
# Demande confirmation avant commande shell, extinction, envoi de mail...
JARVIS_CONFIRM=true
# Dossiers ou JARVIS peut lire et chercher des fichiers (separes par ;)
JARVIS_ALLOWED_DIRS=C:\Users\Utilisateur\Documents;C:\Users\Utilisateur\Downloads;C:\Users\Utilisateur\Desktop
